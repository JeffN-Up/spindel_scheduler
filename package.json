{
  "name": "spindel-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test:parser": "tsx tests/sheetService.test.ts && tsx tests/technicianRosterService.test.ts",
    "test:happy-schedule": "tsx tests/happyScheduleService.test.ts && tsx tests/commuteService.test.ts",
    "test:local-commands": "tsx tests/localCommandService.test.ts && tsx tests/shiftRuleService.test.ts && tsx tests/myDayService.test.ts",
    "test:mobile-shell": "tsx tests/mobileShell.test.ts",
    "test:app-shell": "tsx tests/appShell.test.ts",
    "test": "pnpm run test:parser && pnpm run test:happy-schedule && pnpm run test:local-commands && pnpm run test:mobile-shell && pnpm run test:app-shell"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.1.0",
    "firebase": "^12.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
